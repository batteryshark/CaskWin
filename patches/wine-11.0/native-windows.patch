+ * Wine's factory; the optional native-host shim decides from the actual caller.
+ * No shim means the ordinary Wine implementation below is unchanged. */
+static BOOL create_system_factory(const void *caller, UINT entrypoint, UINT flags,
+        REFIID iid, void **factory, HRESULT *result)
+{
+    BOOL (WINAPI *create_factory)(const void *, UINT, UINT, REFIID, void **, HRESULT *);
+    HMODULE shim;
