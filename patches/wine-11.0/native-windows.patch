+static int d3dbc_lower_ps2_texld_coords(struct vsir_program *program)
+{
+    struct vsir_program_iterator it = vsir_program_iterator(&program->instructions), mov_it;
+    uint32_t sampler_masks[16], mask;
+    struct vkd3d_shader_instruction *ins, *mov;
+    struct vkd3d_shader_src_param coords;
+    struct vkd3d_shader_location loc;
+    unsigned int sampler, temp, component;
+    bool identity;
+
+    if (program->shader_version.type != VKD3D_SHADER_TYPE_PIXEL || program->shader_version.major != 2)
+        return VKD3D_OK;
+
+    for (sampler = 0; sampler < ARRAY_SIZE(sampler_masks); ++sampler)
+        sampler_masks[sampler] = VKD3DSP_WRITEMASK_ALL;
+    for (ins = vsir_program_iterator_head(&it); ins; ins = vsir_program_iterator_next(&it))
+    {
+        const struct vkd3d_shader_semantic *semantic = &ins->declaration.semantic;
+
+        if (ins->opcode != VSIR_OP_DCL || semantic->resource.reg.reg.type != VKD3DSPR_COMBINED_SAMPLER)
+            continue;
+        sampler = semantic->resource.reg.reg.idx[0].offset;
+        if (sampler >= ARRAY_SIZE(sampler_masks))
+            continue;
+        if (semantic->resource_type == VKD3D_SHADER_RESOURCE_TEXTURE_2D)
+            sampler_masks[sampler] = VKD3DSP_WRITEMASK_0 | VKD3DSP_WRITEMASK_1;
+        else if (semantic->resource_type == VKD3D_SHADER_RESOURCE_TEXTURE_CUBE
+                || semantic->resource_type == VKD3D_SHADER_RESOURCE_TEXTURE_3D)
+            sampler_masks[sampler] = VKD3DSP_WRITEMASK_0 | VKD3DSP_WRITEMASK_1 | VKD3DSP_WRITEMASK_2;
+    }
+
+    for (ins = vsir_program_iterator_head(&it); ins; ins = vsir_program_iterator_next(&it))
+    {
+        if (ins->opcode != VSIR_OP_TEXLD || ins->src_count != 2)
+            continue;
+        coords = ins->src[0];
+        sampler = ins->src[1].reg.idx[0].offset;
+        mask = sampler < ARRAY_SIZE(sampler_masks) ? sampler_masks[sampler] : VKD3DSP_WRITEMASK_ALL;
+        if (ins->flags & (VKD3DSI_TEXLD_PROJECT | VKD3DSI_TEXLD_BIAS))
+            mask |= VKD3DSP_WRITEMASK_3;
+        identity = !coords.modifiers;
+        for (component = 0; component < VKD3D_VEC4_SIZE; ++component)
+        {
+            if ((mask & (1u << component)) && vsir_swizzle_get_component(coords.swizzle, component) != component)
+                identity = false;
+        }
+
+        /* ps_2_x texld does not accept coordinate swizzles or modifiers. An
+         * input t# needs no move when only unused components are swizzled. */
+        if (identity && coords.reg.type == VKD3DSPR_TEXTURE)
+        {
+            ins->src[0].swizzle = VKD3D_SHADER_NO_SWIZZLE;
+            continue;
+        }
+
+        /* Materialise actual permutations before register allocation. Write
+         * a full temporary so packing cannot reintroduce a texld swizzle.
+         * Scalar moves use replicate swizzles, which are also valid in ps_2_0.
+         * Fill unused components from x instead of reading undeclared inputs. */
+        loc = ins->location;
+        temp = program->temp_count++;
+        if (!(mov = vsir_program_iterator_insert_before(&it, &mov_it, VKD3D_VEC4_SIZE)))
+            return VKD3D_ERROR_OUT_OF_MEMORY;
+        for (component = 0; component < VKD3D_VEC4_SIZE; ++component)
+        {
+            unsigned int source = vsir_swizzle_get_component(coords.swizzle, mask & (1u << component) ? component : 0);
+
+            if (!vsir_instruction_init_with_params(program, mov, &loc, VSIR_OP_MOV, 1, 1))
+                return VKD3D_ERROR_OUT_OF_MEMORY;
+            vsir_dst_param_init(&mov->dst[0], VKD3DSPR_TEMP, coords.reg.data_type, 1);
+            mov->dst[0].reg.idx[0].offset = temp;
+            mov->dst[0].reg.dimension = VSIR_DIMENSION_VEC4;
+            mov->dst[0].write_mask = 1u << component;
+            mov->src[0] = coords;
+            mov->src[0].swizzle = vkd3d_shader_create_swizzle(source, source, source, source);
+            mov = vsir_program_iterator_next(&mov_it);
+        }
+        ins = vsir_program_iterator_current(&it);
+        vsir_src_param_init(&ins->src[0], VKD3DSPR_TEMP, coords.reg.data_type, 1);
+        ins->src[0].reg.idx[0].offset = temp;
+        ins->src[0].reg.dimension = VSIR_DIMENSION_VEC4;
+        ins->src[0].swizzle = VKD3D_SHADER_NO_SWIZZLE;
+    }
+    return VKD3D_OK;
+}
