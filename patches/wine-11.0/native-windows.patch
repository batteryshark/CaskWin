+	note.wave.pWave = wave;
+	note.wave.pWaveBank = wave->parentBank;
+	note.wave.waveIndex = wave->index;
+	note.wave.cueIndex = wave->parentCue ? wave->parentCue->index : FACTINDEX_INVALID;
+	note.wave.pCue = wave->parentCue;
+	note.wave.pSoundBank = wave->parentCue ? wave->parentCue->parentBank : NULL;
+	engine->notificationCallback(&note);
