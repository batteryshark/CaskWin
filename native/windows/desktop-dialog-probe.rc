#include <windows.h>
101 DIALOGEX 10, 12, 180, 90
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME
EXSTYLE WS_EX_DLGMODALFRAME
CAPTION "Winedows dialog fixture"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Fixture-owned modal dialog", -1, 8, 6, 160, 12
    EDITTEXT 102, 8, 24, 160, 14, ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "OK", IDOK, 116, 62, 52, 16
END

102 DIALOGEX 0, 0, 100, 50
STYLE WS_CHILD | DS_CONTROL
FONT 8, "MS Shell Dlg"
BEGIN
    EDITTEXT 102, 4, 4, 90, 14, ES_AUTOHSCROLL | WS_TABSTOP
END
